rules_version = '2';

// Foto keluhan: estates/{estateId}/complaints/{residentId}/{complaintId}/{file}
// - Warga hanya bisa mengunggah ke folder miliknya sendiri (gambar, maks. 5 MB).
// - Pengelola perumahan & warga pemilik bisa melihat.
// - File tidak bisa diubah/dihapus dari aplikasi.
service firebase.storage {
  match /b/{bucket}/o {
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Rumah milik akun warga (rumah utama atau salah satu homeKeys).
    function myHome(estateId, residentId) {
      return me().role == 'warga'
        && ((me().estateId == estateId && me().get('residentId', '') == residentId)
          || (estateId + '/' + residentId) in me().get('homeKeys', []));
    }

    // Pengelola bisa mengelola beberapa perumahan (estateIds).
    function adminOf(estateId) {
      return me().role == 'pengelola'
        && (me().estateId == estateId || estateId in me().get('estateIds', []));
    }

    // Foto profil akun: hanya pemilik akun yang mengunggah (gambar, maks.
    // 3 MB); bisa dilihat pengguna yang login.
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Dokumen pendaftaran warga mandiri (KTP / bukti hunian).
    match /estates/{estateId}/registrations/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || adminOf(estateId));
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Ijin renovasi: lampiran pengajuan, bukti deposit, foto barang.
    // estates/{estateId}/renovations/{residentId}/{renovationId}/...
    match /estates/{estateId}/renovations/{residentId}/{renovationId}/{allPaths=**} {
      allow read: if request.auth != null
        && (adminOf(estateId)
          || myHome(estateId, residentId));

      allow create: if request.auth != null
        && (adminOf(estateId)
          || myHome(estateId, residentId))
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/(msword|vnd[.]openxmlformats-officedocument[.].*|vnd[.]ms-excel)'));

      allow update, delete: if false;
    }

    // Bukti transfer IPL: estates/{estateId}/payments/{residentId}/{paymentId}/{file}
    match /estates/{estateId}/payments/{residentId}/{paymentId}/{fileName} {
      allow read: if request.auth != null
        && (adminOf(estateId)
          || myHome(estateId, residentId));

      allow create: if request.auth != null
        && myHome(estateId, residentId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }

    // Foto pengumuman: diunggah pengelola, bisa dilihat semua pengguna yang
    // login (pengumuman bisa dikirim ke beberapa perumahan sekaligus).
    match /estates/{estateId}/announcements/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && adminOf(estateId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Foto penanganan keluhan (diunggah pengelola saat memperbarui status).
    match /estates/{estateId}/complaints/{residentId}/{complaintId}/status/{fileName} {
      allow read: if request.auth != null
        && (adminOf(estateId) || myHome(estateId, residentId));
      allow create: if request.auth != null
        && adminOf(estateId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /estates/{estateId}/complaints/{residentId}/{complaintId}/{fileName} {
      allow read: if request.auth != null
        && (adminOf(estateId)
          || myHome(estateId, residentId));

      allow create: if request.auth != null
        && myHome(estateId, residentId)
        && fileName.matches('[0-2]\\.jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }
  }
}
