rules_version = '2';

// Aturan akses Amani Living.
// - Profil login ada di /users/{uid}:
//     { estateId, estateIds?, role: 'warga'|'pengelola'|'pendaftar', residentId?,
//       name, householdRole?: 'anggota', relation?,
//       homeKeys?: ['estateId/residentId'], homeEstates?: [estateId],
//       memberKeys?: ['estateId/residentId'] }  (satu akun, beberapa rumah)
//   Kepala keluarga & anggota rumah berbagi residentId yang sama, sehingga
//   aturan "data milik rumah ini" berlaku untuk semuanya.
//   Pengelola bisa mengelola beberapa perumahan lewat estateIds (estateId =
//   perumahan utama). Warga hanya terikat ke satu estateId.
//   Profil HANYA dibuat lewat Cloud Function / Console, tidak bisa ditulis dari aplikasi.
// - Warga hanya bisa membaca data miliknya sendiri. Pengelola bisa membaca semua
//   data di perumahannya.
// - Pembayaran IPL hanya transfer ke rekening perumahan + kode unik. Pembayaran
//   dibuat & diverifikasi (tagihan -> lunas) oleh Cloud Function; warga hanya
//   mengunggah bukti / membatalkan, pengelola (hak billing) bisa menolak bukti.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Pendaftar (registrasi mandiri yang belum disetujui) tidak termasuk:
    // belum boleh membaca data perumahan.
    function inEstate(estateId) {
      return signedIn()
        && me().role in ['warga', 'pengelola']
        && (me().estateId == estateId
          || (me().role == 'pengelola' && estateId in me().get('estateIds', []))
          || (me().role == 'warga' && estateId in me().get('homeEstates', [])));
    }

    // Satu akun warga bisa punya beberapa rumah: rumah utama
    // (estateId/residentId) + homeKeys ["estateId/residentId", ...].
    function myHome(estateId, residentId) {
      return (me().estateId == estateId && me().get('residentId', '') == residentId)
        || (estateId + '/' + residentId) in me().get('homeKeys', []);
    }

    // Kepala keluarga rumah tersebut (bukan anggota rumah).
    function headOf(estateId, residentId) {
      return myHome(estateId, residentId)
        && !((estateId + '/' + residentId) in me().get('memberKeys', []))
        && !(me().estateId == estateId
          && me().get('residentId', '') == residentId
          && me().get('householdRole', '') == 'anggota');
    }

    function isAdmin(estateId) {
      return inEstate(estateId) && me().role == 'pengelola';
    }

    // Tim pengelola: estates/{e}/staff/{uid} { isOwner, permissions[] }.
    // Pengelola yang tidak tercatat di tim perumahan dianggap pemilik (akun
    // lama). Pemilik punya semua hak.
    function staffPath(estateId) {
      return /databases/$(database)/documents/estates/$(estateId)/staff/$(request.auth.uid);
    }

    function isOwner(estateId) {
      return isAdmin(estateId)
        && (!exists(staffPath(estateId)) || get(staffPath(estateId)).data.isOwner == true);
    }

    // Hak: masterData, residents, billing, bankAccounts, complaints, visitors,
    // announcements, renovations, renovationLogs.
    function can(estateId, perm) {
      return isOwner(estateId)
        || (isAdmin(estateId) && perm in get(staffPath(estateId)).data.permissions);
    }

    function ownsExisting(estateId) {
      return inEstate(estateId) && myHome(estateId, resource.data.residentId);
    }

    function ownsNew(estateId) {
      return inEstate(estateId)
        && me().role == 'warga'
        && myHome(estateId, request.resource.data.residentId);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Satu-satunya perubahan dari aplikasi: menandai password sementara
      // sudah diganti. Peran & perumahan hanya ditulis server.
      allow update: if signedIn() && request.auth.uid == uid
        && ((onlyChanges(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false)
          // Preferensi notifikasi push.
          || (onlyChanges(['notifPrefs'])
            && request.resource.data.notifPrefs is map
            && request.resource.data.notifPrefs.keys().hasOnly(['announcements', 'bills']))
          // Foto profil sendiri (URL Storage), atau dihapus.
          || (onlyChanges(['photoUrl'])
            && (!('photoUrl' in request.resource.data)
              || (request.resource.data.photoUrl is string
                && request.resource.data.photoUrl.size() <= 2000))));
      allow create, delete: if false;
    }

    // Token perangkat untuk notifikasi push (FCM), hanya milik sendiri.
    match /users/{uid}/devices/{token} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    function validName(max) {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= max;
    }

    match /estates/{estateId} {
      allow read: if inEstate(estateId);
      // Master perumahan: nama, alamat, tarif IPL, jatuh tempo, deposit
      // renovasi, pendaftaran mandiri (hak masterData). Rekening pembayaran:
      // hak bankAccounts (terpisah dari hak tagihan).
      allow update: if (can(estateId, 'bankAccounts')
          && onlyChanges(['bankAccounts'])
          && request.resource.data.bankAccounts is list
          && request.resource.data.bankAccounts.size() <= 5)
        // Info masjid / musholla perumahan (jadwal sholat).
        || (can(estateId, 'masterData')
          && onlyChanges(['mosque'])
          && request.resource.data.mosque is map
          && request.resource.data.mosque.keys().hasOnly(['name', 'info'])
          && request.resource.data.mosque.name is string
          && request.resource.data.mosque.name.size() <= 100
          && request.resource.data.mosque.info is string
          && request.resource.data.mosque.info.size() <= 1000)
        // Fitur keluhan warga dinyalakan / dimatikan.
        || ((can(estateId, 'complaints') || can(estateId, 'masterData'))
          && onlyChanges(['complaintsEnabled'])
          && request.resource.data.complaintsEnabled is bool)
        // Nominal deposit renovasi: juga oleh pengelola berhak ijin renovasi.
        || (can(estateId, 'renovations')
          && onlyChanges(['renovationDepositSmall', 'renovationDepositLarge'])
          && request.resource.data.renovationDepositSmall is int
          && request.resource.data.renovationDepositSmall > 0
          && request.resource.data.renovationDepositLarge is int
          && request.resource.data.renovationDepositLarge > 0)
        || (can(estateId, 'masterData')
        && onlyChanges(['name', 'address', 'monthlyFee',
          'renovationDepositSmall', 'renovationDepositLarge',
          'registrationOpen', 'billDueDay'])
        && (request.resource.data.get('billDueDay', 10) is int
          && request.resource.data.get('billDueDay', 10) >= 1
          && request.resource.data.get('billDueDay', 10) <= 28)
        && request.resource.data.get('registrationOpen', true) is bool
        && (request.resource.data.get('renovationDepositSmall', 1) is int
          && request.resource.data.get('renovationDepositSmall', 1) > 0)
        && (request.resource.data.get('renovationDepositLarge', 1) is int
          && request.resource.data.get('renovationDepositLarge', 1) > 0)
        && validName(100)
        && (!('address' in request.resource.data)
          || (request.resource.data.address is string
            && request.resource.data.address.size() <= 300))
        && request.resource.data.monthlyFee is int
        && request.resource.data.monthlyFee > 0);
      allow create, delete: if false;

      // Level akses & tim pengelola: hanya pemilik yang mengubah. Anggota tim
      // dibuat/dikeluarkan lewat Cloud Function (akun login); level aksesnya
      // boleh diganti pemilik langsung, dengan hak yang sama persis dengan
      // dokumen level.
      match /adminRoles/{roleId} {
        allow read: if isAdmin(estateId);
        allow create, update: if isOwner(estateId)
          && request.resource.data.keys().hasOnly(['name', 'permissions'])
          && validName(40)
          && request.resource.data.permissions is list
          && request.resource.data.permissions.hasOnly(['masterData', 'residents',
            'billing', 'bankAccounts', 'complaints', 'visitors', 'announcements',
            'renovations', 'renovationLogs']);
        allow delete: if isOwner(estateId);
      }

      match /staff/{uid} {
        allow read: if isAdmin(estateId);
        allow update: if isOwner(estateId)
          && uid != request.auth.uid
          && onlyChanges(['isOwner', 'roleId', 'roleName', 'permissions'])
          && (request.resource.data.isOwner == true
            || (request.resource.data.roleId is string
              && request.resource.data.permissions
                == get(/databases/$(database)/documents/estates/$(estateId)/adminRoles/$(request.resource.data.roleId)).data.permissions));
        allow create, delete: if false;
      }

      // Master Cluster > Blok > No. rumah. Semua anggota perumahan bisa
      // membaca (untuk daftar pilihan), hanya pengelola yang bisa mengubah.
      match /clusters/{clusterId} {
        allow read: if inEstate(estateId);
        allow create, update: if can(estateId, 'masterData')
          && request.resource.data.keys().hasOnly(['name'])
          && validName(60);
        allow delete: if can(estateId, 'masterData');
      }

      match /blocks/{blockId} {
        allow read: if inEstate(estateId);
        allow create, update: if can(estateId, 'masterData')
          && request.resource.data.keys().hasOnly(['clusterId', 'typeId', 'name'])
          && request.resource.data.clusterId is string
          && exists(/databases/$(database)/documents/estates/$(estateId)/clusters/$(request.resource.data.clusterId))
          // Setiap blok berisi satu tipe dari cluster yang sama.
          && request.resource.data.typeId is string
          && get(/databases/$(database)/documents/estates/$(estateId)/houseTypes/$(request.resource.data.typeId)).data.clusterId
            == request.resource.data.clusterId
          && validName(20);
        allow delete: if can(estateId, 'masterData');
      }

      // Tipe rumah milik satu cluster.
      match /houseTypes/{typeId} {
        allow read: if inEstate(estateId);
        allow create, update: if can(estateId, 'masterData')
          && request.resource.data.keys().hasOnly(['clusterId', 'name', 'buildingArea', 'landArea', 'monthlyFee'])
          // Tarif IPL khusus tipe (opsional).
          && (request.resource.data.get('monthlyFee', null) == null
            || (request.resource.data.monthlyFee is int
              && request.resource.data.monthlyFee > 0))
          && request.resource.data.clusterId is string
          && validName(40)
          && (request.resource.data.get('buildingArea', null) == null
            || request.resource.data.buildingArea is int)
          && (request.resource.data.get('landArea', null) == null
            || request.resource.data.landArea is int);
        allow delete: if can(estateId, 'masterData');
      }

      match /houses/{houseId} {
        allow read: if inEstate(estateId);
        allow create, update: if can(estateId, 'masterData')
          && request.resource.data.keys().hasOnly(['clusterId', 'blockId', 'number'])
          && request.resource.data.blockId is string
          && request.resource.data.clusterId is string
          && request.resource.data.number is string
          && request.resource.data.number.size() > 0
          && request.resource.data.number.size() <= 10;
        allow delete: if can(estateId, 'masterData');
      }

      match /residents/{residentId} {
        allow read: if isAdmin(estateId)
          || (inEstate(estateId) && myHome(estateId, residentId));
        // Membuat warga baru (beserta akunnya) lewat Cloud Function createResident.
        allow create, delete: if false;
        // Pengelola boleh mengubah data warga, termasuk mengatur / memindah
        // rumah (houseId harus ada di master rumah perumahan ini).
        allow update: if can(estateId, 'residents')
          && onlyChanges(['name', 'houseNo', 'phone', 'houseId'])
          && request.resource.data.houseNo is string
          && (request.resource.data.get('houseId', null) == null
            || exists(/databases/$(database)/documents/estates/$(estateId)/houses/$(request.resource.data.houseId)));
      }

      match /bills/{billId} {
        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow create: if can(estateId, 'billing')
          && request.resource.data.status == 'belumBayar'
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
        // Lunas hanya lewat verifikasi pembayaran (Cloud Function).
        allow update: if false;
        allow delete: if can(estateId, 'billing');
      }

      // Pembayaran (transfer + kode unik). Dibuat oleh createPayment,
      // diterima oleh verifyPayment (Cloud Functions).
      match /payments/{paymentId} {
        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow create, delete: if false;
        // Warga mengunggah bukti: menunggu transfer (belum kedaluwarsa) atau
        // ditolak (unggah ulang) -> menunggu verifikasi.
        allow update: if (ownsExisting(estateId)
            && me().role == 'warga'
            && onlyChanges(['status', 'proofUrl', 'submittedAt', 'note'])
            && request.resource.data.status == 'menungguVerifikasi'
            && (resource.data.status == 'ditolak'
              || (resource.data.status == 'menungguTransfer'
                && request.time < resource.data.expiresAt))
            && request.resource.data.proofUrl is string
            && request.resource.data.proofUrl.size() <= 2000
            && request.resource.data.submittedAt == request.time
            && request.resource.data.note == '')
          // Warga membatalkan sebelum diverifikasi.
          || (ownsExisting(estateId)
            && me().role == 'warga'
            && onlyChanges(['status'])
            && resource.data.status in ['menungguTransfer', 'ditolak']
            && request.resource.data.status == 'dibatalkan')
          // Pengelola menolak bukti dengan alasan.
          || (can(estateId, 'billing')
            && onlyChanges(['status', 'note', 'reviewedAt', 'reviewedBy'])
            && resource.data.status == 'menungguVerifikasi'
            && request.resource.data.status == 'ditolak'
            && request.resource.data.note is string
            && request.resource.data.note.size() > 0
            && request.resource.data.note.size() <= 500
            && request.resource.data.reviewedAt == request.time);
      }

      match /complaints/{complaintId} {
        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow create: if ownsNew(estateId)
          // Fitur keluhan bisa dimatikan pengelola per perumahan.
          && get(/databases/$(database)/documents/estates/$(estateId)).data
            .get('complaintsEnabled', true) == true
          && request.resource.data.status == 'baru'
          && !('updates' in request.resource.data)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.description.size() <= 2000
          && (!('photoUrls' in request.resource.data)
            || (request.resource.data.photoUrls is list
              && request.resource.data.photoUrls.size() <= 3));
        // Penanganan: status + satu entri riwayat (catatan & foto) per update.
        allow update: if can(estateId, 'complaints')
          && onlyChanges(['status', 'updates'])
          && request.resource.data.status in ['baru', 'diproses', 'selesai']
          && request.resource.data.updates is list
          && request.resource.data.updates.size()
            == resource.data.get('updates', []).size() + 1;
        allow delete: if false;
      }

      match /visitors/{visitorId} {
        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow create: if ownsNew(estateId)
          && request.resource.data.checkedInAt == null
          && request.resource.data.code is string;
        // Satpam/pengelola melakukan check-in.
        allow update: if can(estateId, 'visitors')
          && onlyChanges(['checkedInAt'])
          && request.resource.data.checkedInAt == request.time;
        allow delete: if can(estateId, 'visitors') || ownsExisting(estateId);
      }

      // Anggota rumah (keluarga/penyewa), ID = uid akun anggota. Dibuat &
      // dihapus lewat Cloud Function; satu rumah saling bisa melihat.
      match /members/{uid} {
        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow write: if false;
      }

      // Pendaftaran warga mandiri (ID dokumen = uid pendaftar). Dibuat &
      // disetujui lewat Cloud Function; pengelola boleh menolak langsung.
      // Kepala keluarga juga boleh membaca & menolak permintaan "gabung"
      // ke rumahnya (persetujuan tetap lewat Cloud Function).
      match /registrations/{uid} {
        function headOfTargetHousehold() {
          return inEstate(estateId)
            && me().role == 'warga'
            && resource.data.kind == 'gabung'
            && headOf(estateId, resource.data.residentId);
        }

        allow read: if isAdmin(estateId)
          || (signedIn() && request.auth.uid == uid)
          || headOfTargetHousehold();
        allow update: if (can(estateId, 'residents') || headOfTargetHousehold())
          && onlyChanges(['status', 'note', 'reviewedAt'])
          && resource.data.status == 'menunggu'
          && request.resource.data.status == 'ditolak'
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.reviewedAt == request.time;
        allow create, delete: if false;
      }

      // Ijin renovasi. Warga mengajukan; deposit wajib sesuai jenis renovasi
      // (diatur di dokumen perumahan). Alur status diatur pengelola.
      match /renovations/{renovationId} {
        function estateDoc() {
          return get(/databases/$(database)/documents/estates/$(estateId)).data;
        }
        function requiredDeposit(type) {
          return type == 'besar'
            ? estateDoc().get('renovationDepositLarge', 5000000)
            : estateDoc().get('renovationDepositSmall', 1000000);
        }

        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow create: if ownsNew(estateId)
          && request.resource.data.keys().hasOnly(['residentId', 'type',
            'description', 'contractor', 'contractorPhone', 'startDate',
            'endDate', 'deposit', 'attachments', 'status', 'depositStatus',
            'adminNote', 'createdAt'])
          && (request.resource.data.get('attachments', []) is list
            && request.resource.data.get('attachments', []).size() <= 5)
          && request.resource.data.type in ['kecil', 'besar']
          && request.resource.data.deposit == requiredDeposit(request.resource.data.type)
          && request.resource.data.status == 'diajukan'
          && request.resource.data.depositStatus == 'belumBayar'
          && request.resource.data.adminNote == ''
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.contractor is string
          && request.resource.data.contractor.size() <= 100
          // Tanggal "YYYY-MM-DD": bisa dibandingkan sebagai teks.
          && request.resource.data.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.endDate >= request.resource.data.startDate
          && request.resource.data.createdAt == request.time;
        // Alur: diajukan -> disetujui -> warga bayar deposit (menunggu
        // verifikasi) -> pengelola verifikasi (dibayar) -> selesai ->
        // deposit dikembalikan.
        allow update: if
          // Pengelola: tinjau, verifikasi deposit, perpanjang, selesai.
          (can(estateId, 'renovations')
            && onlyChanges(['status', 'depositStatus', 'depositMethod',
              'depositProofUrl', 'depositPaidAt', 'depositRefund',
              'depositRefundedAt', 'adminNote', 'endDate'])
            && request.resource.data.status in
              ['diajukan', 'disetujui', 'ditolak', 'selesai', 'dibatalkan']
            && request.resource.data.depositStatus in
              ['belumBayar', 'menungguVerifikasi', 'dibayar', 'dikembalikan']
            && request.resource.data.endDate >= resource.data.startDate
            && request.resource.data.get('depositRefund', 0) <= resource.data.deposit)
          // Warga: membatalkan sebelum deposit dibayar.
          || (ownsExisting(estateId)
            && onlyChanges(['status'])
            && (resource.data.status == 'diajukan'
              || resource.data.status == 'disetujui')
            && resource.data.depositStatus == 'belumBayar'
            && request.resource.data.status == 'dibatalkan')
          // Warga: membayar deposit setelah ijin disetujui.
          || (ownsExisting(estateId)
            && onlyChanges(['depositStatus', 'depositMethod',
              'depositProofUrl', 'depositSubmittedAt'])
            && resource.data.status == 'disetujui'
            && resource.data.depositStatus == 'belumBayar'
            && request.resource.data.depositStatus == 'menungguVerifikasi'
            && request.resource.data.depositMethod is string
            && request.resource.data.depositSubmittedAt == request.time);
        allow delete: if false;
      }

      // Catatan barang masuk/keluar selama renovasi (pengelola/satpam atau
      // warga pemilik), hanya saat pekerjaan berjalan.
      match /renovationLogs/{logId} {
        function renovation() {
          return get(/databases/$(database)/documents/estates/$(estateId)/renovations/$(request.resource.data.renovationId)).data;
        }

        allow read: if isAdmin(estateId) || ownsExisting(estateId);
        allow create: if inEstate(estateId)
          && request.resource.data.keys().hasOnly(['renovationId', 'residentId',
            'direction', 'item', 'quantity', 'note', 'photoUrls', 'at',
            'recordedBy'])
          // Pekerjaan berjalan: disetujui dan deposit sudah diterima.
          && renovation().status == 'disetujui'
          && renovation().depositStatus == 'dibayar'
          && (request.resource.data.get('photoUrls', []) is list
            && request.resource.data.get('photoUrls', []).size() <= 3)
          && renovation().residentId == request.resource.data.residentId
          && (can(estateId, 'renovationLogs') || can(estateId, 'renovations')
            || myHome(estateId, request.resource.data.residentId))
          && request.resource.data.direction in ['masuk', 'keluar']
          && request.resource.data.item is string
          && request.resource.data.item.size() > 0
          && request.resource.data.item.size() <= 100
          && request.resource.data.quantity is string
          && request.resource.data.quantity.size() <= 40
          && request.resource.data.note.size() <= 200
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if can(estateId, 'renovations');
      }

      match /announcements/{announcementId} {
        allow read: if inEstate(estateId);
        allow create: if can(estateId, 'announcements')
          && request.resource.data.keys().hasOnly(['title', 'body', 'photoUrl',
            'until', 'createdBy', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 5000
          && (!('photoUrl' in request.resource.data)
            || (request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() <= 2000))
          && (!('until' in request.resource.data)
            || request.resource.data.until.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if can(estateId, 'announcements');
      }
    }
  }
}
